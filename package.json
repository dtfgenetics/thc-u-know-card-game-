{
  "name": "thc-u-know-card-game",
  "private": true,
  "version": "0.2.0",
  "description": "Online multiplayer THC U Know card game for browser and Discord play.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @thc-u-know/server --filter @thc-u-know/web dev",
    "test": "pnpm --filter @thc-u-know/shared test",
    "test:production-runtime": "node scripts/production-runtime-smoke.mjs",
    "lint": "pnpm -r lint",
    "start": "node apps/server/dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
